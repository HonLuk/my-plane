#!/usr/bin/env python3
"""
Plane CLI — Zero-dependency Python wrapper for the Plane.so REST API.

Manage projects, work items, cycles, modules, comments, and members
from the command line or through AI agent integrations.

Requirements:
  - Python 3.8+
  - PLANE_API_KEY environment variable
  - PLANE_WORKSPACE environment variable (workspace slug)

No pip installs needed — stdlib only.
"""

import os
import sys
import argparse

# ---------------------------------------------------------------------------
# Module path setup — ensure we can import sibling modules
# ---------------------------------------------------------------------------

# When running as a script, add the scripts directory to the path
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
if SCRIPT_DIR not in sys.path:
    sys.path.insert(0, SCRIPT_DIR)

# Import modular components
from plane_api import api, get_workspace, _validate_id
from plane_output import format_output, green, yellow, dim, bold, PRIORITY_LABELS

# Import command handlers
from commands.user import cmd_me
from commands.workspace import cmd_members_list
from commands.projects import cmd_projects_list, cmd_projects_get, cmd_projects_create
from commands.work_items import (
    cmd_issues_list, cmd_issues_get, cmd_issues_create, cmd_issues_update,
    cmd_issues_assign, cmd_issues_delete, cmd_issues_search, cmd_issues_get_short
)
from commands.comments import cmd_comments_list, cmd_comments_add
from commands.cycles import cmd_cycles_list, cmd_cycles_get, cmd_cycles_create
from commands.modules import cmd_modules_list, cmd_modules_get, cmd_modules_create
from commands.states import cmd_states_list
from commands.labels import cmd_labels_list
from commands.images import cmd_get_image, cmd_get_images


# ===========================================================================
# CLI definition
# ===========================================================================

def _add_pagination_args(parser):
    """Add pagination and query parameters to a list command parser."""
    parser.add_argument("--cursor", help="Pagination cursor for next/prev page")
    parser.add_argument("--per-page", type=int, help="Number of results per page")
    parser.add_argument("--fields", help="Comma-separated fields to return (e.g., 'id,name,state')")
    parser.add_argument("--expand", help="Comma-separated relations to expand (e.g., 'assignees,state')")


def main():
    # Common arguments parser that all subcommands will inherit
    common_parser = argparse.ArgumentParser(add_help=False)
    common_parser.add_argument(
        "--format", "-f",
        choices=["table", "json"],
        default="table",
        help="Output format (default: table)",
    )

    parser = argparse.ArgumentParser(
        prog="plane",
        description="Plane.so CLI — manage projects, work items, cycles, modules, and more.",
        epilog="Set PLANE_API_KEY and PLANE_WORKSPACE environment variables before use.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        parents=[common_parser],
    )
    subparsers = parser.add_subparsers(dest="command", help="Available commands")

    # ── me ──────────────────────────────────────────────────────────────
    me_parser = subparsers.add_parser(
        "me",
        help="Show current user info",
        description="Display the authenticated user's ID, name, email, and display name.",
        parents=[common_parser],
    )
    me_parser.set_defaults(func=cmd_me)

    # ── members ─────────────────────────────────────────────────────────
    mem_parser = subparsers.add_parser(
        "members",
        help="List workspace members",
        description="List all members in the workspace with their name, email, role, and UUID.",
        parents=[common_parser],
    )
    _add_pagination_args(mem_parser)
    mem_parser.set_defaults(func=cmd_members_list)

    # ── projects ────────────────────────────────────────────────────────
    proj = subparsers.add_parser(
        "projects",
        help="Manage projects",
        description="Create, list, and view projects in the workspace.",
        parents=[common_parser],
    )
    proj_sub = proj.add_subparsers(dest="subcommand")

    p_list = proj_sub.add_parser(
        "list",
        help="List all projects",
        description="Show all projects in the workspace with identifier, name, and UUID.",
        parents=[common_parser],
    )
    _add_pagination_args(p_list)
    p_list.set_defaults(func=cmd_projects_list)

    p_get = proj_sub.add_parser(
        "get",
        help="Get project details",
        description="View full details of a specific project by ID.",
        parents=[common_parser],
    )
    p_get.add_argument("project", help="Project ID (UUID or identifier)")
    p_get.set_defaults(func=cmd_projects_get)

    p_create = proj_sub.add_parser(
        "create",
        help="Create a new project",
        description="Create a new project with a name and short identifier.",
        parents=[common_parser],
    )
    p_create.add_argument("--name", required=True, help="Project display name (e.g., 'My App')")
    p_create.add_argument("--identifier", required=True, help="Short key for work items (e.g., 'PROJ')")
    p_create.add_argument("--description", help="Optional project description")
    p_create.set_defaults(func=cmd_projects_create)

    # ── issues (work items) ─────────────────────────────────────────────
    iss = subparsers.add_parser(
        "issues",
        help="Manage work items (issues)",
        description="List, create, update, assign, delete, and search work items.",
        parents=[common_parser],
    )
    iss_sub = iss.add_subparsers(dest="subcommand")

    i_list = iss_sub.add_parser(
        "list",
        help="List work items in a project",
        description="Show work items with optional filters for state, priority, or assignee.",
        parents=[common_parser],
    )
    i_list.add_argument("--project", "-p", required=True, help="Project ID (UUID)")
    i_list.add_argument("--state", help="Filter by state ID")
    i_list.add_argument("--priority", choices=["urgent", "high", "medium", "low", "none"],
                        help="Filter by priority level")
    i_list.add_argument("--assignee", help="Filter by assignee user ID")
    _add_pagination_args(i_list)
    i_list.add_argument("--order-by", help="Sort field (e.g., '-created_at', 'priority')")
    i_list.set_defaults(func=cmd_issues_list)

    i_get = iss_sub.add_parser(
        "get",
        help="Get work item details",
        description="View full details of a specific work item by UUID.",
        parents=[common_parser],
    )
    i_get.add_argument("--project", "-p", required=True, help="Project ID (UUID)")
    i_get.add_argument("issue", help="Work item ID (UUID)")
    i_get.set_defaults(func=cmd_issues_get)

    i_create = iss_sub.add_parser(
        "create",
        help="Create a new work item",
        description="Create a work item with title and optional fields.",
        parents=[common_parser],
    )
    i_create.add_argument("--project", "-p", required=True, help="Project ID (UUID)")
    i_create.add_argument("--name", required=True, help="Work item title")
    i_create.add_argument("--description", help="Plain-text description (converted to HTML)")
    i_create.add_argument("--priority", choices=["urgent", "high", "medium", "low", "none"],
                          help="Priority level")
    i_create.add_argument("--state", help="State ID")
    i_create.add_argument("--assignee", help="Assignee user ID")
    i_create.add_argument("--label", help="Label ID")
    i_create.set_defaults(func=cmd_issues_create)

    i_update = iss_sub.add_parser(
        "update",
        help="Update an existing work item",
        description="Modify title, description, priority, or state of a work item.",
        parents=[common_parser],
    )
    i_update.add_argument("--project", "-p", required=True, help="Project ID (UUID)")
    i_update.add_argument("issue", help="Work item ID (UUID)")
    i_update.add_argument("--name", help="New title")
    i_update.add_argument("--description", help="New description")
    i_update.add_argument("--priority", choices=["urgent", "high", "medium", "low", "none"],
                          help="New priority level")
    i_update.add_argument("--state", help="New state ID")
    i_update.set_defaults(func=cmd_issues_update)

    i_assign = iss_sub.add_parser(
        "assign",
        help="Assign a work item to members",
        description="Assign one or more workspace members to a work item.",
        parents=[common_parser],
    )
    i_assign.add_argument("--project", "-p", required=True, help="Project ID (UUID)")
    i_assign.add_argument("issue", help="Work item ID (UUID)")
    i_assign.add_argument("assignees", nargs="+", help="One or more member user IDs")
    i_assign.set_defaults(func=cmd_issues_assign)

    i_delete = iss_sub.add_parser(
        "delete",
        help="Delete a work item",
        description="Permanently delete a work item (irreversible).",
        parents=[common_parser],
    )
    i_delete.add_argument("--project", "-p", required=True, help="Project ID (UUID)")
    i_delete.add_argument("issue", help="Work item ID (UUID)")
    i_delete.set_defaults(func=cmd_issues_delete)

    i_search = iss_sub.add_parser(
        "search",
        help="Search work items across workspace",
        description="Search work items by text across all projects in the workspace.",
        parents=[common_parser],
    )
    i_search.add_argument("query", help="Search query text")
    i_search.set_defaults(func=cmd_issues_search)

    i_get_short = iss_sub.add_parser(
        "get-short",
        help="Get work item by short ID (e.g., PROJ-123)",
        description="Quick access to a work item using its short identifier format.",
        parents=[common_parser],
    )
    i_get_short.add_argument("issue_short", help="Work item short ID (PROJECT-SEQ format, e.g., 'YJS-42')")
    i_get_short.set_defaults(func=cmd_issues_get_short)

    # ── comments ────────────────────────────────────────────────────────
    cmt = subparsers.add_parser(
        "comments",
        help="Manage work item comments",
        description="List and add comments on work items.",
        parents=[common_parser],
    )
    cmt_sub = cmt.add_subparsers(dest="subcommand")

    c_list = cmt_sub.add_parser(
        "list",
        help="List comments / activity on a work item",
        description="Show comments and optionally all activity history for a work item.",
        parents=[common_parser],
    )
    c_list.add_argument("--project", "-p", required=True, help="Project ID (UUID)")
    c_list.add_argument("--issue", "-i", required=True, help="Work item ID (UUID)")
    c_list.add_argument("--all", action="store_true",
                        help="Show all activity (field changes), not just comments")
    c_list.set_defaults(func=cmd_comments_list)

    c_add = cmt_sub.add_parser(
        "add",
        help="Add a comment to a work item",
        description="Post a new comment on a work item.",
        parents=[common_parser],
    )
    c_add.add_argument("--project", "-p", required=True, help="Project ID (UUID)")
    c_add.add_argument("--issue", "-i", required=True, help="Work item ID (UUID)")
    c_add.add_argument("body", help="Comment text")
    c_add.set_defaults(func=cmd_comments_add)

    # ── cycles ──────────────────────────────────────────────────────────
    cyc = subparsers.add_parser(
        "cycles",
        help="Manage cycles (sprints)",
        description="List, view, and create cycles (sprints) in projects.",
        parents=[common_parser],
    )
    cyc_sub = cyc.add_subparsers(dest="subcommand")

    cy_list = cyc_sub.add_parser(
        "list",
        help="List cycles",
        description="Show all cycles in a project with name, dates, and UUID.",
        parents=[common_parser],
    )
    cy_list.add_argument("--project", "-p", required=True, help="Project ID (UUID)")
    _add_pagination_args(cy_list)
    cy_list.set_defaults(func=cmd_cycles_list)

    cy_get = cyc_sub.add_parser(
        "get",
        help="Get cycle details",
        description="View full details of a specific cycle.",
        parents=[common_parser],
    )
    cy_get.add_argument("--project", "-p", required=True, help="Project ID (UUID)")
    cy_get.add_argument("cycle", help="Cycle ID (UUID)")
    cy_get.set_defaults(func=cmd_cycles_get)

    cy_create = cyc_sub.add_parser(
        "create",
        help="Create a new cycle",
        description="Create a new sprint cycle with optional start/end dates.",
        parents=[common_parser],
    )
    cy_create.add_argument("--project", "-p", required=True, help="Project ID (UUID)")
    cy_create.add_argument("--name", required=True, help="Cycle name (e.g., 'Sprint 1')")
    cy_create.add_argument("--start", help="Start date (YYYY-MM-DD)")
    cy_create.add_argument("--end", help="End date (YYYY-MM-DD)")
    cy_create.set_defaults(func=cmd_cycles_create)

    # ── modules ─────────────────────────────────────────────────────────
    mod = subparsers.add_parser(
        "modules",
        help="Manage modules",
        description="List, view, and create modules (feature groups) in projects.",
        parents=[common_parser],
    )
    mod_sub = mod.add_subparsers(dest="subcommand")

    m_list = mod_sub.add_parser(
        "list",
        help="List modules",
        description="Show all modules in a project.",
        parents=[common_parser],
    )
    m_list.add_argument("--project", "-p", required=True, help="Project ID (UUID)")
    _add_pagination_args(m_list)
    m_list.set_defaults(func=cmd_modules_list)

    m_get = mod_sub.add_parser(
        "get",
        help="Get module details",
        description="View full details of a specific module.",
        parents=[common_parser],
    )
    m_get.add_argument("--project", "-p", required=True, help="Project ID (UUID)")
    m_get.add_argument("module", help="Module ID (UUID)")
    m_get.set_defaults(func=cmd_modules_get)

    m_create = mod_sub.add_parser(
        "create",
        help="Create a new module",
        description="Create a new module with optional description and dates.",
        parents=[common_parser],
    )
    m_create.add_argument("--project", "-p", required=True, help="Project ID (UUID)")
    m_create.add_argument("--name", required=True, help="Module name")
    m_create.add_argument("--description", help="Module description")
    m_create.add_argument("--start", help="Start date (YYYY-MM-DD)")
    m_create.add_argument("--end", help="Target date (YYYY-MM-DD)")
    m_create.set_defaults(func=cmd_modules_create)

    # ── states ──────────────────────────────────────────────────────────
    states = subparsers.add_parser(
        "states",
        help="List workflow states in a project",
        description="Show available workflow states (e.g., Backlog, Todo, In Progress, Done).",
        parents=[common_parser],
    )
    states.add_argument("--project", "-p", required=True, help="Project ID (UUID)")
    _add_pagination_args(states)
    states.set_defaults(func=cmd_states_list)

    # ── labels ──────────────────────────────────────────────────────────
    labels = subparsers.add_parser(
        "labels",
        help="List labels in a project",
        description="Show available labels for categorizing work items.",
        parents=[common_parser],
    )
    labels.add_argument("--project", "-p", required=True, help="Project ID (UUID)")
    _add_pagination_args(labels)
    labels.set_defaults(func=cmd_labels_list)

    # ── get-image ─────────────────────────────────────────────────────
    gi = subparsers.add_parser(
        "get-image",
        help="Download a single image from a work item",
        description=(
            "Download a specific image embedded in a work item's description. "
            "The asset UUID can be found in the <image-component src=\"UUID\"> "
            "tag of the work item's description_html field."
        ),
        parents=[common_parser],
    )
    gi.add_argument("issue_short", help="Work item short ID (e.g., 'PROJ-123')")
    gi.add_argument("asset_id", help="Image asset UUID (from description_html)")
    gi.add_argument("file", help="Output file path (extension auto-appended if missing)")
    gi.set_defaults(func=cmd_get_image)

    # ── get-images ────────────────────────────────────────────────────
    gis = subparsers.add_parser(
        "get-images",
        help="Download all images from a work item",
        description=(
            "Download every image embedded in a work item's description to a "
            "directory.  Files are named by their asset UUID with the correct "
            "extension (e.g., 20745b59-....png)."
        ),
        parents=[common_parser],
    )
    gis.add_argument("issue_short", help="Work item short ID (e.g., 'PROJ-123')")
    gis.add_argument("dir", help="Output directory (created if it does not exist)")
    gis.set_defaults(func=cmd_get_images)

    # ── parse & dispatch ────────────────────────────────────────────────
    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        sys.exit(1)

    if hasattr(args, "func"):
        args.func(args)
    else:
        # Subcommand not given — show subparser help
        for action in parser._subparsers._actions:
            if isinstance(action, argparse._SubParsersAction):
                sub = action.choices.get(args.command)
                if sub:
                    sub.print_help()
                    break
        sys.exit(1)


if __name__ == "__main__":
    main()